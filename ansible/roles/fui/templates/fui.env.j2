# Managed by Ansible - local edits will be overwritten.
FUI_SERVICE_NAME={{ fui_managed_unit }}
FUI_SYSTEMCTL_PATH={{ fui_systemctl_path }}
FUI_JOURNALCTL_PATH={{ fui_journalctl_path }}
FUI_SUDO_PATH={{ fui_sudo_path }}
FUI_RESET_SCRIPT={{ fui_reset_script }}
FUI_INSTANCES_FILE={{ fui_instances_file }}
FUI_ROOT_PATH={{ fui_base_path }}
FUI_COMMAND_TIMEOUT=30
FUI_RESET_TIMEOUT={{ fui_reset_timeout }}
FUI_MOD_SYNC_TIMEOUT={{ fui_mod_sync_timeout }}
FUI_MOD_UPDATE_ENABLED=true
FUI_FACTORIO_INSTALL_DIR={{ factorio_install_dir }}
FUI_ENGINE_SCRIPT={{ fui_engine_script if fui_engine_management_enabled | bool else '' }}
FUI_ENGINE_TIMEOUT={{ fui_engine_timeout }}
FUI_PASSWORD={{ vault_fui_admin_password }}
FUI_SECRET_KEY={{ vault_fui_secret_key }}
FUI_SESSION_TTL={{ fui_session_ttl }}
# Set to true once this is served over HTTPS so the cookie is never sent in
# clear. Leaving it true on a plain-HTTP site makes login silently fail.
FUI_COOKIE_SECURE={{ fui_cookie_secure | lower }}
