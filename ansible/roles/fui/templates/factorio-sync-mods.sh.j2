#!/bin/sh
# Managed by Ansible - local edits will be overwritten.
set -eu

was_running=false
if {{ fui_systemctl_path }} is-active --quiet factorio@{{ item.id }}.service; then
    was_running=true
    {{ fui_systemctl_path }} stop factorio@{{ item.id }}.service
fi

restart_if_needed() {
    if [ "$was_running" = true ]; then
        {{ fui_systemctl_path }} start factorio@{{ item.id }}.service
    fi
}
trap restart_if_needed EXIT

result=$(/usr/bin/python3 {{ fui_install_dir }}/app/mods.py \
    --saves {{ (item.state_dir ~ '/saves') | quote }} \
    --mods {{ (item.state_dir ~ '/mods') | quote }} \
    --server-settings {{ (item.config_dir ~ '/server-settings.json') | quote }})

find {{ (item.state_dir ~ '/mods') | quote }} -maxdepth 1 -type f \
    \( -name '*.zip' -o -name mod-list.json \) \
    -exec chown {{ factorio_user | quote }}:{{ factorio_group | quote }} {} + \
    -exec chmod 0640 {} +

printf '%s\n' "$result"