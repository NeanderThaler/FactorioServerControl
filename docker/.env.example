# Copy to docker/.env to override defaults. docker/.env is ignored by Git.
FSC_HTTP_PORT=8080
FACTORIO_VERSION=stable
FACTORIO_PORT=34197
FACTORIO_UPLOAD1_PORT=34198
FACTORIO_UPLOAD2_PORT=34199

FACTORIO_SERVER_NAME=Docker Factorio Server
FACTORIO_SERVER_DESCRIPTION=Managed by Factorio Server Control
FACTORIO_MAX_PLAYERS=10
FACTORIO_SERVER_PUBLIC=false
FACTORIO_GAME_PASSWORD=

# Required only for public listing and automatic portal mod downloads.
FACTORIO_USERNAME=
FACTORIO_TOKEN=

# Leave blank to generate and persist values under docker/data/fui/.
FUI_PASSWORD=
FUI_SECRET_KEY=
